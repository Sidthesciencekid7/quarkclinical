# ─── Clerk authentication (optional) ───────────────────────────────
# Copy this file to `.env.local` and paste your Clerk PUBLISHABLE key.
# Get it free at https://dashboard.clerk.com → your app → API Keys.
# The publishable key is safe to ship in frontend code (it is NOT a secret).
#
# When this is set, sign-in/sign-up activates and /app is protected.
# When it is empty or missing, the app runs in open mode (no login).
VITE_CLERK_PUBLISHABLE_KEY=

# ─── API origin (optional) ─────────────────────────────────────────
# Leave UNSET for same-origin `/api` calls: dev uses the Vite proxy, prod uses
# the Vercel rewrite in vercel.json (recommended — see DEPLOY.md). Set this to
# your backend URL ONLY for a direct cross-origin setup (then also set
# ALLOWED_ORIGINS on the backend). No trailing slash.
# VITE_API_BASE_URL=https://your-backend.up.railway.app
