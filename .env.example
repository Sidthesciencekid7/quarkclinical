ANTHROPIC_API_KEY=your_anthropic_api_key_here
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pkbe
PUBMED_API_KEY=your_pubmed_api_key_here

# Clerk backend auth — verifies the session token on every /api/* request.
# CLERK_ISSUER = your Clerk Frontend API URL (https://<slug>.clerk.accounts.dev for dev).
# Leave CLERK_ISSUER unset to run the API fully open (local testing only).
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
CLERK_ISSUER=https://your-slug.clerk.accounts.dev

# Browser origins allowed by CORS (comma-separated). Only needed when the
# frontend calls the backend cross-origin. If you proxy /api through Vercel to
# the backend (recommended — see DEPLOY.md) the browser is same-origin and you
# can leave this unset. Defaults to http://localhost:5173 for local dev.
# ALLOWED_ORIGINS=https://your-app.vercel.app

# Operator email notification for new "Contact sales" leads (services/email_service.py).
# ENTIRELY OPTIONAL: with these unset the feature is a silent no-op — leads are
# still saved to the DB and visible in the admin dashboard, just not emailed.
# Set all three of SMTP_HOST / SMTP_USER / SMTP_PASSWORD to activate it.
# For Gmail as the SENDING account you must use an App Password (requires 2FA
# on that account), not the normal account password.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_sending_account@gmail.com
# SMTP_PASSWORD=your_16_char_app_password
# SMTP_FROM=your_sending_account@gmail.com
# Where lead notifications are delivered. Defaults to quark2027@gmail.com.
# LEADS_NOTIFY_EMAIL=quark2027@gmail.com
